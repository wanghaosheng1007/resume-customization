{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-customization.local/schema/resume.schema.json",
  "title": "TailoredResume",
  "type": "object",
  "required": ["meta", "jd_analysis", "summary", "skills", "experience", "education", "gaps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["target_role", "company", "generated_at", "language", "output_slug"],
      "additionalProperties": false,
      "properties": {
        "target_role": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "language": { "type": "string", "const": "en" },
        "output_slug": { "type": "string", "minLength": 1 }
      }
    },
    "jd_analysis": {
      "type": "object",
      "required": ["must_have", "nice_to_have", "keywords", "responsibilities"],
      "additionalProperties": false,
      "properties": {
        "must_have": { "type": "array", "items": { "type": "string" } },
        "nice_to_have": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "responsibilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "skills": {
      "type": "object",
      "required": ["core", "tools", "domains"],
      "additionalProperties": false,
      "properties": {
        "core": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "domains": { "type": "array", "items": { "type": "string" } }
      }
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/experienceEntry" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectEntry" }
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/educationEntry" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gapEntry" }
    }
  },
  "$defs": {
    "bullet": {
      "type": "object",
      "required": ["id", "text", "evidence_id", "skill_points", "jd_tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^b\\d+$" },
        "text": { "type": "string", "minLength": 1 },
        "evidence_id": { "type": "string", "pattern": "^ev_" },
        "skill_points": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "jd_tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "experienceEntry": {
      "type": "object",
      "required": ["id", "company", "title", "location", "start", "end", "relevance", "bullets"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^exp_" },
        "company": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^(\\d{4}-\\d{2}|present)$" },
        "relevance": { "type": "string", "enum": ["high", "medium", "low"] },
        "bullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bullet" },
          "minItems": 1
        }
      }
    },
    "projectEntry": {
      "type": "object",
      "required": ["id", "name", "period", "bullets"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^proj_" },
        "name": { "type": "string" },
        "period": { "type": "string" },
        "bullets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bullet" }
        }
      }
    },
    "educationEntry": {
      "type": "object",
      "required": ["id", "institution", "degree", "end", "details"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^edu_" },
        "institution": { "type": "string" },
        "degree": { "type": "string" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "details": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gapEntry": {
      "type": "object",
      "required": ["requirement", "status", "note"],
      "additionalProperties": false,
      "properties": {
        "requirement": { "type": "string" },
        "status": { "type": "string", "enum": ["missing", "partial"] },
        "note": { "type": "string" }
      }
    }
  }
}
